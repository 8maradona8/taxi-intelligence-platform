ENVIRONMENT=development

APP_NAME=Taxi Intelligence Platform
APP_VERSION=0.1.0

HOST=0.0.0.0
PORT=8000


# Database

DATABASE_URL=postgresql+asyncpg://tip:tip@localhost:5432/tip


# Redis

REDIS_URL=redis://localhost:6379


# External APIs

AIRPORT_API_KEY=
WEATHER_API_KEY=
EVENTS_API_KEY=

# MET Norway requires an identifiable User-Agent.
# Replace the email below with a real project contact email.

WEATHER_USER_AGENT=Taxi-Intelligence-Platform/0.1.0 (contact: your-email@example.com)


# Airport scheduler

AIRPORT_SCHEDULER_ENABLED=true
AIRPORT_SCHEDULER_INTERVAL_SECONDS=300
AIRPORT_SCHEDULER_RUN_ON_STARTUP=true
AIRPORT_SCHEDULER_MAX_ATTEMPTS=2
AIRPORT_SCHEDULER_RETRY_BACKOFF_SECONDS=2.0


# Railway scheduler

RAILWAY_SCHEDULER_ENABLED=true
RAILWAY_SCHEDULER_INTERVAL_SECONDS=300
RAILWAY_SCHEDULER_RUN_ON_STARTUP=true
RAILWAY_SCHEDULER_MAX_ATTEMPTS=2
RAILWAY_SCHEDULER_RETRY_BACKOFF_SECONDS=2.0


# Bus scheduler

BUS_SCHEDULER_ENABLED=true
BUS_SCHEDULER_INTERVAL_SECONDS=300
BUS_SCHEDULER_RUN_ON_STARTUP=true
BUS_SCHEDULER_MAX_ATTEMPTS=2
BUS_SCHEDULER_RETRY_BACKOFF_SECONDS=2.0

BUS_ARRIVALS_HORIZON_HOURS=2


# Weather scheduler

WEATHER_SCHEDULER_ENABLED=true
WEATHER_SCHEDULER_INTERVAL_SECONDS=900
WEATHER_SCHEDULER_RUN_ON_STARTUP=true
WEATHER_SCHEDULER_MAX_ATTEMPTS=2
WEATHER_SCHEDULER_RETRY_BACKOFF_SECONDS=2.0
